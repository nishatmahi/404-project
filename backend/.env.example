# Backend Environment Variables
# Copy this file to .env and fill in the values

# Django core settings
SECRET_KEY=your-secret-key-here-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS - comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=

# Database (SQLite by default; no config needed for local dev)
# For production with Postgres/MySQL, set DATABASE_URL

# JWT Token Expiry (in minutes)
ACCESS_TOKEN_LIFETIME=60
REFRESH_TOKEN_LIFETIME=7

# Seed credentials (used by: python manage.py seed_demo)
# Change these before deploying to production!
DEMO_EMAIL=demo@example.com
DEMO_USERNAME=demo
DEMO_PASSWORD=demo1234

ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234

# Email (optional; not used in this project)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# For production on Render/PythonAnywhere:
# SECRET_KEY=<generate-a-new-secure-key>
# DEBUG=False
# ALLOWED_HOSTS=<your-service>.onrender.com,localhost
# FRONTEND_URL=https://<your-vercel-app>.vercel.app
